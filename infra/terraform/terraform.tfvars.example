# Copy this file to terraform.tfvars and fill in the secrets.
# terraform.tfvars is gitignored — never commit it.

proxmox_url      = "https://192.168.1.161:8006/api2/json"
proxmox_username = "root@pam"
proxmox_password = "CHANGE_ME"
proxmox_node     = "skull"

koa_ip    = "192.168.1.200"
ollama_ip = "192.168.1.201"
gateway   = "192.168.1.1"
bridge    = "vmbr0"

# VMID of the Packer-built Ollama template (default 9001 matches ollama-vm.pkr.hcl)
# ollama_template_vm_id = 9001

# Generate at: https://login.tailscale.com/admin/settings/keys
# Use a one-time pre-auth key (not reusable).
tailscale_authkey = "tskey-auth-CHANGE_ME"

# Your SSH public key (paste contents of ~/.ssh/id_ed25519.pub or id_rsa.pub)
ssh_public_key = "CHANGE_ME"
