# Copy to ollama-vm.pkrvars.hcl and fill in secrets.
# ollama-vm.pkrvars.hcl is gitignored — never commit it.

proxmox_password = "CHANGE_ME"

# Your SSH public key (injected into root during build)
ssh_public_key = "CHANGE_ME"

# Optional overrides
# proxmox_url         = "https://192.168.1.161:8006/api2/json"
# proxmox_username    = "root@pam"
# proxmox_node        = "skull"
# template_vm_id      = 9001
