# Koa environment variables — copy to /etc/koa/env or .env and fill in values
# Never commit a file containing real secrets.

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=            # Anthropic API key (required for Claude models)
KOA_WEB_TOKEN=                # Bearer token for web console authentication

# ── Core ──────────────────────────────────────────────────────────────────────
KOA_HOME=~/.koa               # Root directory for DB, credentials, memories
KOA_MODEL=claude-haiku-4-5-20251001  # Default Anthropic model ID
KOA_MAX_TOKENS=               # Max output tokens per turn (default: model max)
KOA_PROVIDER=anthropic        # LLM provider: anthropic | ollama

# ── Ollama (self-hosted) ───────────────────────────────────────────────────────
KOA_OLLAMA_MODEL=llama3.2     # Model tag to use when provider=ollama
KOA_OLLAMA_BASE_URL=http://localhost:11434  # Trusted host only — never point to user-supplied or untrusted URLs

# ── Agent behaviour ───────────────────────────────────────────────────────────
KOA_SMART_ROUTING=true        # Route to specialist agents automatically
KOA_ENGRAM=true               # Enable Engram session memory
KOA_COMPACT_TURNS=20          # Compact context after N turns
KOA_CHECKPOINT_TURNS=         # Auto-checkpoint every N turns
KOA_CHECKPOINT_MINUTES=       # Auto-checkpoint every N minutes
KOA_MAX_TOOL_OUTPUT=20000     # Max chars captured from a single tool call
KOA_NO_CACHE=false            # Disable Anthropic prompt caching

# ── Sandbox (code execution) ──────────────────────────────────────────────────
KOA_SANDBOX_BACKEND=local     # local | docker
KOA_SANDBOX_TIMEOUT_MS=10000  # Execution timeout in milliseconds

# ── Voice / TTS ───────────────────────────────────────────────────────────────
KOA_TTS_PROVIDER=say          # say (macOS) | elevenlabs
ELEVENLABS_API_KEY=           # ElevenLabs API key (required when provider=elevenlabs)
ELEVENLABS_VOICE_ID=          # ElevenLabs voice ID

# ── SpiderBrain ───────────────────────────────────────────────────────────────
SPIDERBRAIN_BRAIN=            # Path to synganglion.json (enables SpiderBrain tools)

# ── Google (Calendar + Gmail) ─────────────────────────────────────────────────
# One OAuth 2.0 client covers both Gmail and Calendar — set these two vars only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=

# ── Channels ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── APNs (iOS push) ───────────────────────────────────────────────────────────
APNS_KEY_PATH=                # Path to .p8 key file
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_SANDBOX=true             # true for dev, false for production

# ── User identity ──────────────────────────────────────────────────────────────
KOA_USER_NAME=

# ── ntfy (push notifications) ─────────────────────────────────────────────────
KOA_NTFY_TOPIC=
KOA_NTFY_BASE_URL=https://ntfy.sh

# ── Third-party tools ─────────────────────────────────────────────────────────
BRAVE_API_KEY=                # Brave Search API key (enables web_search tool)
OPENAI_API_KEY=               # OpenAI key (used by Whisper transcription)

# ── Debug ─────────────────────────────────────────────────────────────────────
KOA_DEBUG=                    # Set to any value to enable verbose debug logging
NODE_ENV=production
